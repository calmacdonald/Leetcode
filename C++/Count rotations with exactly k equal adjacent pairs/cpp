class Solution {
public:
    int countRotations(string s, int k) {
        int j = -1;
        int n = s.size();
        int ans = 0;
        while(j < n-1){
            string str = s.substr(j+1, n - j-1) + s.substr(0, j+1);
            int score = 0;
            for(int i = 0; i < n-1; i++){
                if(str[i] == str[i+1]){
                    score++;
                }
            }
            if(score == k){
                ans++;
            }
            j++;
        }
        return ans;
    }
};